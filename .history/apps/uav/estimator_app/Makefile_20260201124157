############################################################################
# apps/uav/estimator_app/Makefile
#
# Estimator Application Build
#
# MỤC ĐÍCH:
# - Build estimator_app thành NSH command "estimator"
# - Link với uORB shared library
#
############################################################################

include $(APPDIR)/Make.defs

# Tên ứng dụng (command trên NSH)
PROGNAME = estimator
PRIORITY = SCHED_PRIORITY_DEFAULT
STACKSIZE = $(CONFIG_UAV_ESTIMATOR_STACKSIZE)
MODULE = $(CONFIG_UAV_ESTIMATOR)

# Main entry point
MAINSRC = estimator_main.cpp

# Thêm CXXFLAGS
CXXFLAGS += -I$(APPDIR)/uav

# C++ configuration (giống sensors_app)
CXXEXT = .cpp
CXXFLAGS += -std=c++17 -fno-rtti -fno-exceptions -fno-threadsafe-statics

include $(APPDIR)/Application.mk
