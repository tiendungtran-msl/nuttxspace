############################################################################
# apps/uav/drivers/gps/Makefile
#
# GPS Driver for u-blox M10N
#
############################################################################

include $(APPDIR)/Make.defs

# GPS application name
PROGNAME  = gps_app
PRIORITY  = SCHED_PRIORITY_DEFAULT
STACKSIZE = 2048
MODULE    = $(CONFIG_UAV_DRIVERS_GPS)

# Main source file (entry point) - includes gps_ubx via header
MAINSRC   = gps_main.cpp

# Library-style source (compiled with the app)
CXXSRCS   =

# Include the UBX driver source as additional object
# We need to add gps_ubx.cpp to the build
VPATH    += :$(APPDIR)/uav/drivers/gps
CXXSRCS  += gps_ubx.cpp

# C++ settings
CXXFLAGS += -I$(APPDIR)
CXXFLAGS += -I$(APPDIR)/uav/uorb
CXXFLAGS += -I$(APPDIR)/uav/drivers/gps

include $(APPDIR)/Application.mk
