include $(APPDIR)/Make.defs

# UAV States Application
PROGNAME  = uav_states
PRIORITY  = SCHED_PRIORITY_DEFAULT
STACKSIZE = $(CONFIG_DEFAULT_TASK_STACKSIZE)
MODULE    = $(CONFIG_EXAMPLES_UAV_STATES)

MAINSRC   = uav_states_main.c

# Drivers
CSRCS += drivers/comm/i2c/i2c.c
CSRCS += drivers/comm/spi/spi.c
CSRCS += drivers/sensors/icm42688p/icm42688p_driver.c
CSRCS += drivers/sensors/bmm150/bmm150_driver.c

# Tasks
CSRCS += tasks/icm42688p_task.c
CSRCS += tasks/bmm150_task.c
CSRCS += tasks/led_task.c
CSRCS += tasks/infor_task.c

# Tests (nếu muốn build test)
# CSRCS += tests/icm42688p_test.c

# Include paths
CFLAGS += -I$(APPDIR)/examples/uav_states
CFLAGS += -I$(APPDIR)/examples/uav_states/drivers
CFLAGS += -I$(APPDIR)/examples/uav_states/drivers/comm/i2c
CFLAGS += -I$(APPDIR)/examples/uav_states/drivers/comm/spi
CFLAGS += -I$(APPDIR)/examples/uav_states/drivers/sensors/icm42688p
CFLAGS += -I$(APPDIR)/examples/uav_states/drivers/sensors/bmm150
CFLAGS += -I$(APPDIR)/examples/uav_states/tasks
CFLAGS += -I$(APPDIR)/examples/uav_states/algorithms
CFLAGS += -I$(APPDIR)/examples/uav_states/utils

include $(APPDIR)/Application.mk
