#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_UAV_STATES_V1
    tristate "UAV States example version 1"
    default n
    ---help---
        Enable the UAV States example application

if EXAMPLES_UAV_STATES_V1

config EXAMPLES_UAV_STATES_V1_PROGNAME
    string "Program name"
    default "uav_states_v1"
    ---help---
        This is the name of the program that will be used when the NSH ELF
        program is installed.

config EXAMPLES_UAV_STATES_V1_PRIORITY
    int "UAV States task priority"
    default 100
    ---help---
        Priority of the UAV States task.

config EXAMPLES_UAV_STATES_V1_STACKSIZE
    int "UAV States stack size"
    default DEFAULT_TASK_STACKSIZE
    ---help---
        Stack size allocated for the UAV States task.

endif